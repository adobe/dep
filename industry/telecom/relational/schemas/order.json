      "picked-up",
      "shipped",
      "delivered"
    ],
    "meta:enum": {
      "placed": "Placed",
      "cancelled": "Cancelled",
      "ready-for-pickup": "Ready for Pickup",
      "picked-up": "Picked Up",
      "shipped": "Shipped",
      "delivered": "Delivered"
    }
  },
  "last_order_status_update": {
    "type": "string",
    "format": "date-time",
    "title": "Last Status Update"
  },
  "payment_type": {
    "type": "string",
    "title": "Payment Type",
    "enum": [
      "credit",
      "debit",
      "gift-card",
      "cash"
    ],
    "meta:enum": {
      "credit": "Credit",
      "debit": "Debit",
      "gift-card": "Gift Card",
      "cash": "Cash"
    }
  },
  "payment_currency_code": {
    "type": "string",
